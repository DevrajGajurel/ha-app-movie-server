#!/usr/bin/with-contenv bashio
# ==============================================================================
# Cloudflare Turnstile clearer (cf-clearance-scraper) — localhost:3000
# Used by movie-server when download hosts return CF challenges.
# ==============================================================================
set -euo pipefail

export DISPLAY="${DISPLAY:-:99}"
export PORT="${CF_CLEARANCE_PORT:-3000}"
export browserLimit="${CF_CLEARANCE_BROWSER_LIMIT:-5}"
export timeOut="${CF_CLEARANCE_TIMEOUT_MS:-60000}"

# Wait briefly for Xvfb to own :99 before Puppeteer launches Chrome.
for _ in $(seq 1 30); do
  if [ -e /tmp/.X11-unix/X99 ] || [ -e /tmp/.X99-lock ]; then
    break
  fi
  sleep 0.5
done

cd /opt/cf-clearance || exit 1
bashio::log.info "Starting cf-clearance-scraper on :${PORT}"
exec node src/index.js

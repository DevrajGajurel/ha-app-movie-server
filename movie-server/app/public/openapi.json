{
  "openapi": "3.0.3",
  "info": {
    "title": "Movie Server API",
    "version": "1.6.10",
    "description": "HTTP API for the Movie Server dashboard, downloads, and Streams catalog."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin (works with Home Assistant Ingress and direct port access)"
    }
  ],
  "tags": [
    { "name": "Config" },
    { "name": "Movies" },
    { "name": "Downloads" },
    { "name": "Proxy" },
    { "name": "Emby" }
  ],
  "paths": {
    "/api/config": {
      "get": {
        "tags": ["Config"],
        "summary": "Get server config",
        "responses": {
          "200": {
            "description": "Current config",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": true }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Config"],
        "summary": "Update config (not available in HA add-on mode)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mainUrl": { "type": "string", "format": "uri" },
                  "secondaryUrl": { "type": "string", "format": "uri", "description": "Optional second listing site; only HD-keyword titles are merged" },
                  "maxPages": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated config" },
          "403": { "description": "Managed by Home Assistant options" },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/api/movies": {
      "get": {
        "tags": ["Movies"],
        "summary": "List scraped movies",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1 }
          },
          {
            "name": "refresh",
            "in": "query",
            "schema": { "type": "boolean" }
          }
        ],
        "responses": {
          "200": {
            "description": "Movie list",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": true }
              }
            }
          }
        }
      }
    },
    "/api/movies/search": {
      "get": {
        "tags": ["Movies"],
        "summary": "Search scraped source titles",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Search results" }
        }
      }
    },
    "/api/downloads": {
      "get": {
        "tags": ["Downloads"],
        "summary": "Discover download options for a source page URL, or secondary (shegu) links by TMDB id",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "uri" },
            "description": "Source detail page URL (primary site). Required unless source=secondary."
          },
          {
            "name": "type",
            "in": "query",
            "schema": { "type": "string", "enum": ["quality", "direct", "shegu"] }
          },
          {
            "name": "source",
            "in": "query",
            "schema": { "type": "string", "enum": ["secondary"] },
            "description": "When secondary, resolve downloads via downloads.shegu.st using tmdbId."
          },
          {
            "name": "tmdbId",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Required when source=secondary."
          },
          {
            "name": "mediaType",
            "in": "query",
            "schema": { "type": "string", "enum": ["movie", "tv"] },
            "description": "movie → /movie/{id}; tv → /tv/{id}/{season}/{episode}."
          },
          {
            "name": "season",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1 },
            "description": "Required when mediaType=tv."
          },
          {
            "name": "episode",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1 },
            "description": "Required when mediaType=tv."
          }
        ],
        "responses": {
          "200": { "description": "Download options" }
        }
      }
    },
    "/api/downloads/save": {
      "post": {
        "tags": ["Downloads"],
        "summary": "Start a server-side download",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "additionalProperties": true }
            }
          }
        },
        "responses": {
          "200": { "description": "Job started" }
        }
      }
    },
    "/api/downloads/season": {
      "post": {
        "tags": ["Downloads"],
        "summary": "Download an entire TV season via shegu (highest quality + link fallback per episode)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tmdbId", "season", "episodeCount"],
                "properties": {
                  "tmdbId": { "type": "string" },
                  "season": { "type": "integer", "minimum": 1 },
                  "episodeCount": { "type": "integer", "minimum": 1 },
                  "movieTitle": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "202": { "description": "Season job started" }
        }
      }
    },
    "/api/downloads/jobs": {
      "get": {
        "tags": ["Downloads"],
        "summary": "List download jobs",
        "responses": {
          "200": { "description": "Jobs list" }
        }
      }
    },
    "/api/downloads/library": {
      "get": {
        "tags": ["Downloads"],
        "summary": "Scan downloaded library markers",
        "responses": {
          "200": { "description": "Downloaded titles / TMDB ids" }
        }
      }
    },
    "/api/downloads/versions": {
      "get": {
        "tags": ["Downloads"],
        "summary": "List local download versions for a title",
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "tmdbId",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Versions with probe info" }
        }
      }
    },
    "/api/downloads/play": {
      "get": {
        "tags": ["Downloads"],
        "summary": "Stream a downloaded media file",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "audioTrack",
            "in": "query",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Media stream" }
        }
      }
    },
    "/api/downloads/media": {
      "delete": {
        "tags": ["Downloads"],
        "summary": "Delete downloaded media for a title",
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "tmdbId",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Deleted" }
        }
      }
    },
    "/api/emby/status": {
      "get": {
        "tags": ["Emby"],
        "summary": "Emby integration status",
        "responses": {
          "200": { "description": "Status" }
        }
      }
    },
    "/api/emby/refresh": {
      "post": {
        "tags": ["Emby"],
        "summary": "Trigger Emby library refresh",
        "responses": {
          "200": { "description": "Refresh requested" }
        }
      }
    }
  }
}
